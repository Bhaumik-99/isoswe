# Frontend
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=

# Backend
ENVIRONMENT=development
DATABASE_URL=
SECRET_KEY=
ENABLE_LOCAL_AUTH_BYPASS=false

# Supabase
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=

# AWS
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=

# Messaging
MESSAGING_PROVIDER=local
SQS_BILLING_JOBS_QUEUE_URL=
SQS_PAYMENT_EVENTS_QUEUE_URL=
SQS_RECONCILIATION_JOBS_QUEUE_URL=
SQS_COMPLAINT_AI_JOBS_QUEUE_URL=
SQS_NOTIFICATION_JOBS_QUEUE_URL=

# Payment
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Complaints & AI Triage (Gemini)
AI_PROVIDER=deterministic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=10
AI_MAX_RETRIES=1
AI_ENABLED=true

# Object Storage
COMPLAINTS_BUCKET_NAME=township-ops-complaints-attachments
S3_ATTACHMENTS_BUCKET_NAME=township-ops-complaints-attachments
USE_MOCK_STORAGE=true
