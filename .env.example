# Environment Identifier (development | staging | production)
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO

# Application Security
SECRET_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Local Development Auth Bypass
# WARNING: MUST ONLY BE ENABLED IN LOCAL DEVELOPMENT. FAILS CLOSED IN STAGING/PRODUCTION.
ENABLE_LOCAL_AUTH_BYPASS=true

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=township_ops
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/township_ops
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/township_ops_test

# AWS Credentials / Region (for production / staging / test)
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=

# Amazon Cognito
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_JWKS_URL=

# AWS SQS Queues
SQS_BILLING_JOBS_QUEUE_URL=
SQS_PAYMENT_EVENTS_QUEUE_URL=
SQS_RECONCILIATION_JOBS_QUEUE_URL=
SQS_COMPLAINT_AI_JOBS_QUEUE_URL=
SQS_NOTIFICATION_JOBS_QUEUE_URL=

# Local Messaging Adapter (for development without AWS credentials)
MESSAGING_PROVIDER=local

# S3 & CloudFront
S3_DOCUMENTS_BUCKET_NAME=
CLOUDFRONT_DISTRIBUTION_ID=

# KMS Keys
KMS_MASTER_KEY_ARN=
