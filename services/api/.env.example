# Backend Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=
ENABLE_LOCAL_AUTH_BYPASS=false

# Database Connection (Supabase Transaction Pooler, port 6543)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/township_ops
TEST_DATABASE_URL=

# Supabase Auth
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=

# AWS Configuration
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=

# Messaging
MESSAGING_PROVIDER=local
SQS_BILLING_JOBS_QUEUE_URL=
SQS_PAYMENT_EVENTS_QUEUE_URL=
SQS_RECONCILIATION_JOBS_QUEUE_URL=
SQS_COMPLAINT_AI_JOBS_QUEUE_URL=
SQS_NOTIFICATION_JOBS_QUEUE_URL=

# Payment Integrations
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
